# Copy to .env (chmod 600) and change both passwords. Never commit .env.
OWNER_PASSWORD=change-me-owner
EMPLOYEE_PASSWORD=change-me-employee

# Only set this if a reverse proxy on THIS server forwards to 127.0.0.1:8081.
# It makes the app trust X-Forwarded-For so the rate limit sees real visitor IPs.
# FORWARDED_ALLOW_IPS=*

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_MINUTE=30
# MAX_INJECTED_ENTRIES=500
# TZ=America/New_York
